# ---------- PostgreSQL (Docker) ----------
# Use 127.0.0.1, not localhost: on Windows, localhost can resolve to IPv6 (::1)
# and reach a locally installed Postgres instead of the Docker container.
POSTGRES_HOST=127.0.0.1
# Host port mapped to the container (docker-compose.yml). Inside the container Postgres listens on 5432.
POSTGRES_PORT=5433
POSTGRES_DB=vietdist
POSTGRES_USER=vietdist_admin
POSTGRES_PASSWORD=change_me_please

# Optional: a full SQLAlchemy URL overrides the POSTGRES_* values for the loaders (CI / Airflow)
# DATABASE_URL=postgresql+psycopg2://vietdist_admin:change_me_please@127.0.0.1:5433/vietdist

# ---------- Loaders ----------
# Folder with the 10 source files, relative to the project root
RAW_DATA_DIR=data/raw

# ---------- dbt ----------
DBT_TARGET=dev
DBT_THREADS=4
