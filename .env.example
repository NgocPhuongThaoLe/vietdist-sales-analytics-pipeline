# ---------- PostgreSQL (Docker) ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vietdist
POSTGRES_USER=vietdist_admin
POSTGRES_PASSWORD=change_me_please

# ---------- Loaders ----------
RAW_DATA_DIR=./data/raw
RAW_SCHEMA=raw
# full_refresh = empty and reload each raw table, append = add rows (incremental, later)
LOAD_MODE=full_refresh

# ---------- dbt ----------
DBT_TARGET=dev
DBT_THREADS=4